{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwi-project.local/schemas/module_result_v1.json",
  "title": "CWI Module Result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "module_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "not_run"
      ]
    },
    "output": {},
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "task_id",
    "module",
    "module_version",
    "status",
    "output",
    "evidence_refs",
    "assumptions",
    "warnings",
    "schema_version"
  ]
}
