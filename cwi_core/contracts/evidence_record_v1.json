{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwi-project.local/schemas/evidence_record_v1.json",
  "title": "CWI Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "observed",
        "published",
        "synthetic",
        "simulated",
        "derived"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection_method": {
      "type": "string",
      "minLength": 1
    },
    "observation_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "rejected"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "evidence_id",
    "source_type",
    "collection_method",
    "limitations",
    "verification_status",
    "schema_version"
  ]
}
