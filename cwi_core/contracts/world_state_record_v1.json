{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwi-project.local/schemas/world_state_record_v1.json",
  "title": "CWI World State Record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "attribute": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "record_type": {
      "type": "string",
      "enum": [
        "observation",
        "state",
        "prediction",
        "hypothesis"
      ]
    },
    "valid_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_time": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retracted",
        "provisional"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "record_id",
    "entity_id",
    "attribute",
    "value",
    "record_type",
    "recorded_time",
    "evidence_ids",
    "provenance",
    "status",
    "schema_version"
  ]
}
